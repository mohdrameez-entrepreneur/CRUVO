{
  "expo": {
    "name": "CRUVO",
    "slug": "cruvo",
    "scheme": [
      "cruvo",
      "com.googleusercontent.apps.226381555368-2r2sje22mjfp1i3i147fnglap7vf02kj"
    ],
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/CRUVO LOGO.jpg",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/CRUVO LOGO.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#121317"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cruvo.app",
      "config": {
        "googleMapsApiKey": ""
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CRUVO needs your location to track your position during rides.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "CRUVO needs your location to track your position during rides.",
        "NSLocationAlwaysUsageDescription": "CRUVO needs your location to track your position during rides."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/CRUVO LOGO.jpg",
        "backgroundColor": "#121317"
      },
      "package": "com.cruvo.app",
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/CRUVO LOGO.jpg"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow CRUVO to use your location for live ride tracking.",
          "locationAlwaysPermission": "Allow CRUVO to use your location for live ride tracking.",
          "locationWhenInUsePermission": "Allow CRUVO to use your location for live ride tracking."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/CRUVO LOGO.jpg",
          "color": "#ffd600"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "c508d09a-d425-4b2a-ba18-75c16ec87f32"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c508d09a-d425-4b2a-ba18-75c16ec87f32"
    }
  }
}
